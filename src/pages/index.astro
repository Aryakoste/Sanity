---
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/600.css';
import '@fontsource/dm-sans/700.css';
import '@fontsource/manrope/500.css';
import '@fontsource/manrope/600.css';
import '@fontsource/manrope/700.css';
import '@fontsource/manrope/800.css';
import '../styles/global.css';
import App from '../components/App';
import {loadLibrary} from '../lib/sanity';
const library = await loadLibrary();
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#213b2b" />
    <meta name="description" content="Keep the things you love for longer. Find a sourced fabric repair, match it to your tools and time, and follow your own saved repair plan." />
    <title>Mend — A little repair goes a long way</title>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <App client:load initialLibrary={library} base={base} />
    <noscript><p class="noscript">The repair library is below. Turn on JavaScript to search, create plans, and save progress.</p></noscript>
  </body>
</html>
